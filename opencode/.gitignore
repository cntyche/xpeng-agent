workspace/projects/*/working/
workspace/projects/*/drafts/
!workspace/projects/.gitkeep
!workspace/uploads/.gitkeep
!workspace/knowledge-base/.gitkeep
!workspace/outputs/.gitkeep
!workspace/sessions/.gitkeep

# Private memory (may contain sensitive user data)
private-agent/memory/*.local.json
private-agent/memory/*.cache.json

# Local sandbox/scratch
.sandbox/
.scratch/
